                  suspend fun updateSingleWidgetNow(context: Context, appWidgetId: Int) {
                      if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                      updateWidgetInternal(context.applicationContext, appWidgetId)
                  }

                  private fun updateAllWidgetsInternal(context: Context) {
                      val manager = AppWidgetManager.getInstance(context)
                      val component = ComponentName(context, ShelfWidgetProvider::class.java)
                      val ids = manager.getAppWidgetIds(component)
                      val prefs = ShelfPreferences(context)
                      prefs.pruneOrphanedWidgets(ids)
                      for (id in ids) {
                          updateWidgetInternal(context, id, manager)
                      }
