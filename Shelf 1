                  private fun updateWidgetInternal(
                      context: Context,
                      appWidgetId: Int,
                      manager: AppWidgetManager = AppWidgetManager.getInstance(context),
                      explicitOptions: Bundle? = null
                  ) {
                      if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return

                      val prefs = ShelfPreferences(context)
                      prefs.ensureWidgetInitialized(appWidgetId)

                      val startRevision = prefs.getWidgetRevision(appWidgetId)
                      val slotAssignments = prefs.getAllSlots(appWidgetId)

                      val options = explicitOptions ?: try {
                          manager.getAppWidgetOptions(appWidgetId)
                      } catch (_: Throwable) {
                          Bundle.EMPTY
                      }

                      val displayMetrics = context.resources.displayMetrics
                      val density = displayMetrics.density.coerceIn(0.75f, 4.5f)
                      val isLandscape = context.resources.configuration.orientation ==
                          Configuration.ORIENTATION_LANDSCAPE

                      val (widthDp, heightDp) = resolveWidgetDimensionsDp(options, isLandscape)

                      var renderWidthPx = max(96, (widthDp * density).roundToInt())
                      var renderHeightPx = max(160, (heightDp * density).roundToInt())
                      var renderDensity = density

                      val totalPixels = renderWidthPx.toLong() * renderHeightPx.toLong()
                      if (totalPixels > MAX_BINDER_SAFE_PIXELS) {
                          val scale = sqrt(MAX_BINDER_SAFE_PIXELS.toDouble() / totalPixels.toDouble()).toFloat()
                          renderWidthPx = max(96, (renderWidthPx * scale).roundToInt())
                          renderHeightPx = max(160, (renderHeightPx * scale).roundToInt())
                          renderDensity = (density * scale).coerceAtLeast(0.75f)
                      }

                      val shelfBitmap = ShelfCanvasRenderer.renderShelves(
                          width = renderWidthPx,
                          height = renderHeightPx,
                          density = renderDensity
                      )

                      val actualHeightPx = max(160, (heightDp * density).roundToInt())
                      val actualWidthPx = max(96, (widthDp * density).roundToInt())
                      val bottomPaddingPx = ShelfCanvasRenderer.computeIconBottomOffsetPx(actualHeightPx, density)
                      val topPaddingPx = max((4f * density).roundToInt(), (actualHeightPx / 4f * 0.10f).roundToInt())
                      val horizontalSlotPaddingPx = max((4f * density).roundToInt(), (actualWidthPx * 0.025f).roundToInt())

                      val tierHeightPx = actualHeightPx / 4f
                      val slotWidthPx = actualWidthPx / 3f
                      val targetIconSizePx = min(
                          tierHeightPx * 0.58f,
                          slotWidthPx * 0.66f
                      ).roundToInt().coerceIn((28f * density).roundToInt(), (64f * density).roundToInt())

                      val views = RemoteViews(context.packageName, R.layout.widget_shelf)
                      views.setImageViewBitmap(R.id.widget_shelf_bg, shelfBitmap)

                      val pm = context.packageManager

                      for (slotIndex in 0 until ShelfPreferences.TOTAL_SLOTS) {
                          val containerId = SLOT_CONTAINER_IDS[slotIndex]
                          val iconViewId = SLOT_ICON_IDS[slotIndex]

                          views.setViewPadding(
                              containerId,
                              horizontalSlotPaddingPx,
                              topPaddingPx,
                              horizontalSlotPaddingPx,
                              bottomPaddingPx
                          )

                          val assignedPackage = slotAssignments[slotIndex]
                          if (!assignedPackage.isNullOrEmpty()) {
                              val resolvedApp = resolveLaunchableApp(pm, assignedPackage, targetIconSizePx)
                              if (resolvedApp != null) {
                                  views.setImageViewBitmap(iconViewId, resolvedApp.iconBitmap)
                                  views.setViewVisibility(iconViewId, View.VISIBLE)
                                  views.setContentDescription(containerId, resolvedApp.label)

                                  val pendingIntent = buildSlotPendingIntent(
                                      context = context,
                                      appWidgetId = appWidgetId,
                                      slotIndex = slotIndex,
                                      packageName = assignedPackage,
                                      launchIntent = resolvedApp.launchIntent
                                  )
                                  views.setOnClickPendingIntent(containerId, pendingIntent)
                              } else {
                                  prefs.clearSlot(appWidgetId, slotIndex)
                                  bindEmptySlot(context, views, appWidgetId, slotIndex, containerId, iconViewId)
                              }
                          } else {
                              bindEmptySlot(context, views, appWidgetId, slotIndex, containerId, iconViewId)
                          }
                      }

                      val currentRevision = prefs.getWidgetRevision(appWidgetId)
                      if (currentRevision != startRevision && slotAssignments != prefs.getAllSlots(appWidgetId)) {
                          return
                      }

                      try {
                          manager.updateAppWidget(appWidgetId, views)
                      } catch (_: Throwable) {
                          // Safe guard against transient launcher host errors during resize
                      }
                  }

                  private fun bindEmptySlot(
                      context: Context,
                      views: RemoteViews,
                      appWidgetId: Int,
                      slotIndex: Int,
                      containerId: Int,
                      iconViewId: Int
                  ) {
                      views.setImageViewResource(iconViewId, R.drawable.empty_slot_placeholder)
                      views.setViewVisibility(iconViewId, View.INVISIBLE)
                      views.setContentDescription(containerId, null)

                      cancelSlotPendingIntent(context, appWidgetId, slotIndex)
                      views.setOnClickPendingIntent(containerId, null)
                  }

                  private fun resolveWidgetDimensionsDp(options: Bundle, isLandscape: Boolean): Pair<Int, Int> {
                      val minWidth = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_WIDTH, 0)
                      val maxWidth = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MAX_WIDTH, 0)
                      val minHeight = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MIN_HEIGHT, 0)
                      val maxHeight = options.getInt(AppWidgetManager.OPTION_APPWIDGET_MAX_HEIGHT, 0)

                      val rawWidthDp = if (isLandscape) {
                          if (maxWidth > 0) maxWidth else minWidth
                      } else {
                          if (minWidth > 0) minWidth else maxWidth
                      }

                      val rawHeightDp = if (isLandscape) {
                          if (minHeight > 0) minHeight else maxHeight
                      } else {
                          if (maxHeight > 0) maxHeight else minHeight
                      }

                      val widthDp = if (rawWidthDp > 0) rawWidthDp.coerceIn(100, 960) else DEFAULT_WIDGET_WIDTH_DP
                      val heightDp = if (rawHeightDp > 0) rawHeightDp.coerceIn(160, 960) else DEFAULT_WIDGET_HEIGHT_DP
                      return Pair(widthDp, heightDp)
                  }

                  private data class ResolvedApp(
                      val label: String,
                      val iconBitmap: Bitmap,
                      val launchIntent: Intent
                  )

                  private fun resolveLaunchableApp(
                      pm: PackageManager,
                      packageName: String,
                      iconSizePx: Int
                  ): ResolvedApp? {
                      return try {
                          val launchIntent = pm.getLaunchIntentForPackage(packageName) ?: run {
                              val fallbackQuery = Intent(Intent.ACTION_MAIN).apply {
                                  addCategory(Intent.CATEGORY_LAUNCHER)
                                  setPackage(packageName)
                              }
                              val matches = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
                                  pm.queryIntentActivities(fallbackQuery, PackageManager.ResolveInfoFlags.of(0L))
                              } else {
                                  @Suppress("DEPRECATION")
                                  pm.queryIntentActivities(fallbackQuery, 0)
                              }
                              val firstMatch = matches.firstOrNull()?.activityInfo ?: return null
                              Intent(Intent.ACTION_MAIN).apply {
                                  addCategory(Intent.CATEGORY_LAUNCHER)
                                  setClassName(firstMatch.packageName, firstMatch.name)
                              }
                          }

                          val appInfo = pm.getApplicationInfo(packageName, 0)
                          val label = pm.getApplicationLabel(appInfo)?.toString()?.ifBlank { packageName }
                              ?: packageName
                          val drawable = pm.getApplicationIcon(appInfo)
                          val bitmap = drawableToSizedBitmap(drawable, iconSizePx)
                          ResolvedApp(label = label, iconBitmap = bitmap, launchIntent = launchIntent)
                      } catch (_: PackageManager.NameNotFoundException) {
                          null
                      } catch (_: Throwable) {
                          null
                      }
                  }

                  fun drawableToSizedBitmap(drawable: Drawable, targetSizePx: Int): Bitmap {
                      val safeSize = targetSizePx.coerceIn(24, 192)
                      if (drawable is BitmapDrawable && drawable.bitmap != null && !drawable.bitmap.isRecycled) {
                          val src = drawable.bitmap
                          if (src.width == safeSize && src.height == safeSize) {
                              return src
                          }
                      }
                      val bitmap = Bitmap.createBitmap(safeSize, safeSize, Bitmap.Config.ARGB_8888)
                      val canvas = Canvas(bitmap)
                      drawable.setBounds(0, 0, safeSize, safeSize)
                      drawable.draw(canvas)
                      return bitmap
                  }

                  private fun slotRequestCode(appWidgetId: Int, slotIndex: Int): Int {
                      return (appWidgetId * 100) + slotIndex
                  }

                  private fun buildSlotPendingIntent(
                      context: Context,
                      appWidgetId: Int,
                      slotIndex: Int,
                      packageName: String,
                      launchIntent: Intent
                  ): PendingIntent {
                      val isolatedIntent = Intent(launchIntent).apply {
                          addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED)
                          setPackage(packageName)
                      }
                      val requestCode = slotRequestCode(appWidgetId, slotIndex)
                      val flags = PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE
                      return PendingIntent.getActivity(context, requestCode, isolatedIntent, flags)
                  }

                  private fun cancelSlotPendingIntent(context: Context, appWidgetId: Int, slotIndex: Int) {
                      try {
                          val dummyIntent = Intent(Intent.ACTION_MAIN).apply {
                              data = Uri.parse("shelfwidget://empty/$appWidgetId/$slotIndex")
                          }
                          val existing = PendingIntent.getActivity(
                              context,
                              slotRequestCode(appWidgetId, slotIndex),
                              dummyIntent,
                              PendingIntent.FLAG_NO_CREATE or PendingIntent.FLAG_IMMUTABLE
                          )
                          existing?.cancel()
                      } catch (_: Throwable) {
                          // Safe no-op
                      }
                  }

                  private fun cancelAllSlotPendingIntents(context: Context, appWidgetId: Int) {
                      for (slotIndex in 0 until ShelfPreferences.TOTAL_SLOTS) {
                          cancelSlotPendingIntent(context, appWidgetId, slotIndex)
                      }
                  }
              }
          }
