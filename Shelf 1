                  <intent>
                      <action android:name="android.intent.action.MAIN" />
                      <category android:name="android.intent.category.LAUNCHER" />
                  </intent>
              </queries>

              <application
                  android:allowBackup="true"
                  android:icon="@mipmap/ic_launcher"
                  android:roundIcon="@mipmap/ic_launcher_round"
                  android:label="@string/app_name"
                  android:supportsRtl="true"
                  android:theme="@style/Theme.ShelfWidget">

                  <activity
                      android:name=".MainActivity"
                      android:exported="true"
                      android:label="@string/app_name"
                      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
                      android:windowSoftInputMode="adjustResize">
                      <intent-filter>
                          <action android:name="android.intent.action.MAIN" />
                          <category android:name="android.intent.category.LAUNCHER" />
                      </intent-filter>
                      <intent-filter>
                          <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
                      </intent-filter>
                  </activity>

                  <receiver
                      android:name=".ShelfWidgetProvider"
                      android:exported="true"
                      android:label="@string/widget_name">
                      <intent-filter>
                          <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                          <action android:name="com.example.shelfwidget.ACTION_REFRESH_WIDGET" />
                      </intent-filter>
                      <intent-filter>
                          <action android:name="android.intent.action.PACKAGE_ADDED" />
                          <action android:name="android.intent.action.PACKAGE_REMOVED" />
                          <action android:name="android.intent.action.PACKAGE_REPLACED" />
                          <data android:scheme="package" />
                      </intent-filter>
                      <meta-data
                          android:name="android.appwidget.provider"
                          android:resource="@xml/shelf_widget_info" />
                  </receiver>

              </application>

          </manifest>
          EOF

          # ------------------------------------------------------------------------------
          # 3. Kotlin Source: ShelfPreferences.kt
          # ------------------------------------------------------------------------------
          cat << 'EOF' > app/src/main/java/com/example/shelfwidget/ShelfPreferences.kt
          package com.example.shelfwidget

          import android.appwidget.AppWidgetManager
          import android.content.Context
          import android.content.SharedPreferences

          /**
           * Persistent local storage repository for ShelfWidget slot assignments.
           * Every widget instance (identified by [appWidgetId]) owns an independent namespace
           * of 12 slots (indices 0..11). Updating Widget A never modifies Widget B.
           */
          class ShelfPreferences(context: Context) {

              private val prefs: SharedPreferences = context.applicationContext
                  .getSharedPreferences(PREFS_FILE_NAME, Context.MODE_PRIVATE)

              fun saveAppToSlot(appWidgetId: Int, slotIndex: Int, packageName: String) {
                  if (!isValidWidgetAndSlot(appWidgetId, slotIndex)) return
                  val sanitizedPkg = packageName.trim()
                  if (sanitizedPkg.isEmpty()) {
                      clearSlot(appWidgetId, slotIndex)
                      return
                  }
                  prefs.edit()
                      .putBoolean(initKey(appWidgetId), true)
                      .putString(slotKey(appWidgetId, slotIndex), sanitizedPkg)
                      .putLong(revisionKey(appWidgetId), System.nanoTime())
                      .apply()
              }

              fun getAppForSlot(appWidgetId: Int, slotIndex: Int): String? {
                  if (!isValidWidgetAndSlot(appWidgetId, slotIndex)) return null
                  val value = prefs.getString(slotKey(appWidgetId, slotIndex), null)?.trim()
                  return if (value.isNullOrEmpty()) null else value
              }

              fun clearSlot(appWidgetId: Int, slotIndex: Int) {
                  if (!isValidWidgetAndSlot(appWidgetId, slotIndex)) return
                  prefs.edit()
                      .putBoolean(initKey(appWidgetId), true)
                      .remove(slotKey(appWidgetId, slotIndex))
                      .putLong(revisionKey(appWidgetId), System.nanoTime())
                      .apply()
              }

              fun getAllSlots(appWidgetId: Int): Map<Int, String> {
                  if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return emptyMap()
                  val result = LinkedHashMap<Int, String>(TOTAL_SLOTS)
                  for (slotIndex in 0 until TOTAL_SLOTS) {
                      val pkg = getAppForSlot(appWidgetId, slotIndex)
                      if (!pkg.isNullOrEmpty()) {
                          result[slotIndex] = pkg
                      }
                  }
                  return result
              }

              fun ensureWidgetInitialized(appWidgetId: Int) {
                  if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                  if (!prefs.getBoolean(initKey(appWidgetId), false)) {
                      prefs.edit()
                          .putBoolean(initKey(appWidgetId), true)
                          .putLong(revisionKey(appWidgetId), System.nanoTime())
                          .apply()
                  }
              }

              fun clearAllSlotsForWidget(appWidgetId: Int) {
                  if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                  val editor = prefs.edit()
                  for (slotIndex in 0 until TOTAL_SLOTS) {
                      editor.remove(slotKey(appWidgetId, slotIndex))
                  }
                  editor.putBoolean(initKey(appWidgetId), true)
                  editor.putLong(revisionKey(appWidgetId), System.nanoTime())
                  editor.apply()
              }

              fun clearWidget(appWidgetId: Int) {
                  if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                  val editor = prefs.edit()
                  for (slotIndex in 0 until TOTAL_SLOTS) {
                      editor.remove(slotKey(appWidgetId, slotIndex))
                  }
                  editor.remove(initKey(appWidgetId))
                  editor.remove(revisionKey(appWidgetId))
                  editor.apply()
              }

              fun getWidgetRevision(appWidgetId: Int): Long {
                  if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return 0L
                  return prefs.getLong(revisionKey(appWidgetId), 0L)
              }

              fun pruneOrphanedWidgets(activeWidgetIds: IntArray) {
                  val activeSet = activeWidgetIds.toSet()
                  val allKeys = prefs.all.keys.toList()
                  val editor = prefs.edit()
                  var modified = false

                  for (key in allKeys) {
                      val extractedId = extractWidgetIdFromKey(key)
                      if (extractedId != null && !activeSet.contains(extractedId)) {
                          editor.remove(key)
                          modified = true
                      }
                  }
                  if (modified) {
                      editor.apply()
                  }
              }

              private fun isValidWidgetAndSlot(appWidgetId: Int, slotIndex: Int): Boolean {
                  return appWidgetId != AppWidgetManager.INVALID_APPWIDGET_ID &&
                      slotIndex in 0 until TOTAL_SLOTS
              }

              private fun slotKey(appWidgetId: Int, slotIndex: Int): String =
                  "widget_${appWidgetId}_slot_${slotIndex}"

              private fun initKey(appWidgetId: Int): String =
                  "widget_${appWidgetId}_initialized"

              private fun revisionKey(appWidgetId: Int): String =
                  "widget_${appWidgetId}_revision"

              private fun extractWidgetIdFromKey(key: String): Int? {
                  if (!key.startsWith("widget_")) return null
                  val afterPrefix = key.removePrefix("widget_")
                  val underscoreIdx = afterPrefix.indexOf('_')
                  if (underscoreIdx <= 0) return null
                  return afterPrefix.substring(0, underscoreIdx).toIntOrNull()
              }

              companion object {
                  private const val PREFS_FILE_NAME = "shelf_widget_independent_prefs"
                  const val TOTAL_SLOTS = 12
                  const val SHELF_COUNT = 4
                  const val SLOTS_PER_SHELF = 3
              }
          }
          EOF

          # ------------------------------------------------------------------------------
          # 4. Kotlin Source: ShelfCanvasRenderer.kt
          # ------------------------------------------------------------------------------
          cat << 'EOF' > app/src/main/java/com/example/shelfwidget/ShelfCanvasRenderer.kt
          package com.example.shelfwidget

          import android.graphics.Bitmap
          import android.graphics.Canvas
          import android.graphics.Color
          import android.graphics.LinearGradient
          import android.graphics.Paint
          import android.graphics.Path
          import android.graphics.RectF
          import android.graphics.Shader
          import android.util.LruCache
          import kotlin.math.max
          import kotlin.math.min
          import kotlin.math.roundToInt

          /**
           * Procedural 2.5D Frosted Glass Shelf Rendering Engine.
           * Generates the four-tier translucent glass shelf background in memory using
           * Canvas, Paint, Path, and LinearGradient shaders with LRU bitmap caching.
           */
          object ShelfCanvasRenderer {

              private const val SHELF_COUNT = 4
              private const val MIN_DIMENSION_PX = 64
              private const val MAX_DIMENSION_PX = 1440

              private val bitmapCache = object : LruCache<String, Bitmap>(8 * 1024) {
                  override fun sizeOf(key: String, value: Bitmap): Int {
                      return max(1, value.allocationByteCountSafe() / 1024)
                  }
              }

              private fun Bitmap.allocationByteCountSafe(): Int {
                  return try {
                      allocationByteCount
                  } catch (_: Throwable) {
                      rowBytes * height
                  }
              }

              @Synchronized
              fun renderShelves(width: Int, height: Int, density: Float): Bitmap {
                  val safeDensity = if (density.isFinite() && density > 0f) {
                      density.coerceIn(0.75f, 4.5f)
                  } else {
                      2.0f
                  }

                  val safeWidth = width.coerceIn(MIN_DIMENSION_PX, MAX_DIMENSION_PX)
                  val safeHeight = height.coerceIn(MIN_DIMENSION_PX, MAX_DIMENSION_PX)
                  val densityBucket = (safeDensity * 100f).roundToInt()
                  val cacheKey = "${safeWidth}x${safeHeight}@$densityBucket"

                  val cached = bitmapCache.get(cacheKey)
                  if (cached != null && !cached.isRecycled) {
                      return cached
                  }

                  val bitmap = Bitmap.createBitmap(safeWidth, safeHeight, Bitmap.Config.ARGB_8888)
                  val canvas = Canvas(bitmap)
                  drawGlassShelves(canvas, safeWidth.toFloat(), safeHeight.toFloat(), safeDensity)

                  bitmapCache.put(cacheKey, bitmap)
                  return bitmap
              }

              @Synchronized
              fun clearCache() {
                  bitmapCache.evictAll()
              }

              fun computeIconBottomOffsetPx(widgetHeightPx: Int, density: Float): Int {
                  val safeHeight = widgetHeightPx.coerceIn(MIN_DIMENSION_PX, MAX_DIMENSION_PX).toFloat()
                  val tierHeight = safeHeight / SHELF_COUNT.toFloat()
                  val shelfTopFromTierBottom = tierHeight * 0.22f
                  val minOffset = (6f * density).roundToInt()
                  return max(minOffset, shelfTopFromTierBottom.roundToInt())
              }

              private fun drawGlassShelves(
                  canvas: Canvas,
                  totalWidth: Float,
                  totalHeight: Float,
                  density: Float
              ) {
                  val tierHeight = totalHeight / SHELF_COUNT.toFloat()
                  val horizontalMargin = (totalWidth * 0.055f).coerceIn(6f * density, 28f * density)
                  val shelfLeft = horizontalMargin
                  val shelfRight = totalWidth - horizontalMargin
                  val shelfSpan = max(32f, shelfRight - shelfLeft)

                  val lipThickness = (tierHeight * 0.115f).coerceIn(7f * density, 18f * density)
                  val deckDepth = (tierHeight * 0.135f).coerceIn(8f * density, 22f * density)
                  val perspectiveInset = (shelfSpan * 0.045f).coerceIn(6f * density, 26f * density)

                  val shadowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
                  val ambientShadowPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
                  val deckFillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
                  val deckBorderPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                      style = Paint.Style.STROKE
                      strokeWidth = max(1f, 0.9f * density)
                      color = Color.argb(58, 225, 245, 255)
                  }
                  val lipFillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
                  val sheenPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.FILL }
                  val lipBorderPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                      style = Paint.Style.STROKE
                      strokeWidth = max(1f, 1.15f * density)
                  }
                  val specularPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                      style = Paint.Style.STROKE
                      strokeCap = Paint.Cap.ROUND
                      strokeWidth = max(1.5f, 1.65f * density)
                  }
                  val bottomReflectPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                      style = Paint.Style.STROKE
                      strokeCap = Paint.Cap.ROUND
                      strokeWidth = max(1f, 1.05f * density)
                  }

                  val deckPath = Path()
                  val clipPath = Path()
                  val lipRect = RectF()
                  val shadowRect = RectF()
                  val ambientRect = RectF()

                  for (i in 0 until SHELF_COUNT) {
                      val tierTop = i * tierHeight
                      val tierBottom = tierTop + tierHeight

                      val lipTop = tierBottom - (tierHeight * 0.22f)
                      val lipBottom = lipTop + lipThickness
                      val deckTop = lipTop - deckDepth
                      val pillRadius = lipThickness * 0.5f

                      // 1. Soft multi-layer drop shadow beneath the shelf
                      val shadowHeight = lipThickness * 1.15f
                      val shadowInset = pillRadius * 0.35f
                      shadowRect.set(
                          shelfLeft + shadowInset,
                          lipBottom - (lipThickness * 0.15f),
                          shelfRight - shadowInset,
                          min(tierBottom - 1f, lipBottom + shadowHeight)
                      )
                      shadowPaint.shader = LinearGradient(
                          0f, shadowRect.top, 0f, shadowRect.bottom,
                          intArrayOf(
                              Color.argb(76, 6, 14, 28),
                              Color.argb(34, 6, 14, 28),
                              Color.argb(0, 6, 14, 28)
                          ),
                          floatArrayOf(0f, 0.55f, 1f),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawRoundRect(shadowRect, pillRadius, pillRadius, shadowPaint)

                      ambientRect.set(
                          shelfLeft + pillRadius * 0.2f,
                          lipBottom - 1f,
                          shelfRight - pillRadius * 0.2f,
                          lipBottom + (lipThickness * 0.42f)
                      )
                      ambientShadowPaint.shader = LinearGradient(
                          0f, ambientRect.top, 0f, ambientRect.bottom,
                          Color.argb(54, 0, 0, 0),
                          Color.argb(0, 0, 0, 0),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawRoundRect(ambientRect, pillRadius * 0.6f, pillRadius * 0.6f, ambientShadowPaint)

                      // 2. 2.5D Receded Perspective Top Glass Deck
                      val backLeft = shelfLeft + perspectiveInset
                      val backRight = shelfRight - perspectiveInset
                      val frontLeft = shelfLeft + (pillRadius * 0.35f)
                      val frontRight = shelfRight - (pillRadius * 0.35f)
                      val lipCenterY = lipTop + (lipThickness * 0.35f)

                      deckPath.reset()
                      deckPath.moveTo(backLeft, deckTop)
                      deckPath.lineTo(backRight, deckTop)
                      deckPath.lineTo(frontRight, lipCenterY)
                      deckPath.lineTo(frontLeft, lipCenterY)
                      deckPath.close()

                      deckFillPaint.shader = LinearGradient(
                          0f, deckTop, 0f, lipCenterY,
                          intArrayOf(
                              Color.argb(26, 225, 245, 255),
                              Color.argb(58, 235, 248, 255),
                              Color.argb(92, 255, 255, 255)
                          ),
                          floatArrayOf(0f, 0.65f, 1f),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawPath(deckPath, deckFillPaint)
                      canvas.drawPath(deckPath, deckBorderPaint)

                      // 3. Main Front Frosted Glass Slab with Rounded Pill Ends
                      lipRect.set(shelfLeft, lipTop, shelfRight, lipBottom)
                      lipFillPaint.shader = LinearGradient(
                          0f, lipTop, 0f, lipBottom,
                          intArrayOf(
                              Color.argb(156, 255, 255, 255),
                              Color.argb(96, 222, 242, 255),
                              Color.argb(68, 185, 222, 250),
                              Color.argb(118, 240, 250, 255)
                          ),
                          floatArrayOf(0f, 0.35f, 0.75f, 1f),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawRoundRect(lipRect, pillRadius, pillRadius, lipFillPaint)

                      // 4. Layered Diagonal Glass Reflection Sheen
                      canvas.save()
                      clipPath.reset()
                      clipPath.addRoundRect(lipRect, pillRadius, pillRadius, Path.Direction.CW)
                      canvas.clipPath(clipPath)

                      sheenPaint.shader = LinearGradient(
                          shelfLeft, lipTop, shelfRight, lipBottom,
                          intArrayOf(
                              Color.argb(0, 255, 255, 255),
                              Color.argb(52, 255, 255, 255),
                              Color.argb(12, 255, 255, 255),
                              Color.argb(44, 255, 255, 255),
                              Color.argb(0, 255, 255, 255)
                          ),
                          floatArrayOf(0.08f, 0.26f, 0.50f, 0.76f, 0.92f),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawRect(lipRect, sheenPaint)
                      canvas.restore()

                      // 5. Crisp Outer Glass Rim Stroke
                      lipBorderPaint.shader = LinearGradient(
                          0f, lipTop, 0f, lipBottom,
                          Color.argb(175, 255, 255, 255),
                          Color.argb(85, 200, 235, 255),
                          Shader.TileMode.CLAMP
                      )
                      canvas.drawRoundRect(lipRect, pillRadius, pillRadius, lipBorderPaint)

                      // 6. Top Specular Highlight Line & Bottom Reflection Line
                      val highlightStartX = shelfLeft + pillRadius * 0.75f
                      val highlightEndX = shelfRight - pillRadius * 0.75f
                      val specularY = lipTop + max(1f, 0.9f * density)

                      if (highlightEndX > highlightStartX) {
                          specularPaint.shader = LinearGradient(
                              highlightStartX, specularY, highlightEndX, specularY,
                              intArrayOf(
                                  Color.argb(40, 255, 255, 255),
                                  Color.argb(230, 255, 255, 255),
                                  Color.argb(245, 255, 255, 255),
                                  Color.argb(230, 255, 255, 255),
                                  Color.argb(40, 255, 255, 255)
                              ),
                              floatArrayOf(0f, 0.15f, 0.5f, 0.85f, 1f),
                              Shader.TileMode.CLAMP
                          )
                          canvas.drawLine(highlightStartX, specularY, highlightEndX, specularY, specularPaint)

                          val bottomReflectY = lipBottom - max(1.2f, 1.2f * density)
                          bottomReflectPaint.shader = LinearGradient(
                              highlightStartX, bottomReflectY, highlightEndX, bottomReflectY,
                              intArrayOf(
                                  Color.argb(15, 195, 235, 255),
                                  Color.argb(125, 220, 245, 255),
                                  Color.argb(15, 195, 235, 255)
                              ),
                              floatArrayOf(0f, 0.5f, 1f),
                              Shader.TileMode.CLAMP
                          )
                          canvas.drawLine(highlightStartX, bottomReflectY, highlightEndX, bottomReflectY, bottomReflectPaint)
                      }
                  }
              }
          }
          EOF

          # ------------------------------------------------------------------------------
          # 5. Kotlin Source: ShelfWidgetProvider.kt
