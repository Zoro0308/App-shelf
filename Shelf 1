                  fun requestUpdateWidget(context: Context, appWidgetId: Int) {
                      if (appWidgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                      val appContext = context.applicationContext
                      widgetScope.launch {
                          updateWidgetInternal(appContext, appWidgetId)
