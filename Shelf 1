              override fun onReceive(context: Context, intent: Intent) {
                  super.onReceive(context, intent)
                  val action = intent.action ?: return

                  when (action) {
                      ACTION_REFRESH_WIDGET -> {
                          val targetId = intent.getIntExtra(
                              AppWidgetManager.EXTRA_APPWIDGET_ID,
                              AppWidgetManager.INVALID_APPWIDGET_ID
                          )
                          val pendingResult = goAsync()
                          widgetScope.launch {
                              try {
                                  if (targetId != AppWidgetManager.INVALID_APPWIDGET_ID) {
                                      updateWidgetInternal(context.applicationContext, targetId)
                                  } else {
                                      updateAllWidgetsInternal(context.applicationContext)
                                  }
                              } finally {
                                  pendingResult.finish()
                              }
                          }
                      }
                      Intent.ACTION_PACKAGE_ADDED,
                      Intent.ACTION_PACKAGE_REMOVED,
                      Intent.ACTION_PACKAGE_REPLACED -> {
                          val pendingResult = goAsync()
                          widgetScope.launch {
                              try {
                                  updateAllWidgetsInternal(context.applicationContext)
                              } finally {
                                  pendingResult.finish()
                              }
                          }
                      }
                  }
              }

              override fun onUpdate(
                  context: Context,
                  appWidgetManager: AppWidgetManager,
                  appWidgetIds: IntArray
              ) {
                  if (appWidgetIds.isEmpty()) return
                  val appContext = context.applicationContext
                  val pendingResult = goAsync()
                  widgetScope.launch {
                      try {
                          val prefs = ShelfPreferences(appContext)
                          for (appWidgetId in appWidgetIds) {
                              prefs.ensureWidgetInitialized(appWidgetId)
                              updateWidgetInternal(appContext, appWidgetId, appWidgetManager)
                          }
                      } finally {
                          pendingResult.finish()
                      }
                  }
              }

              override fun onAppWidgetOptionsChanged(
                  context: Context,
                  appWidgetManager: AppWidgetManager,
                  appWidgetId: Int,
                  newOptions: Bundle
              ) {
                  super.onAppWidgetOptionsChanged(context, appWidgetManager, appWidgetId, newOptions)
                  val appContext = context.applicationContext
                  val pendingResult = goAsync()
                  widgetScope.launch {
                      try {
                          updateWidgetInternal(appContext, appWidgetId, appWidgetManager, newOptions)
                      } finally {
                          pendingResult.finish()
                      }
                  }
              }

              override fun onDeleted(context: Context, appWidgetIds: IntArray) {
                  super.onDeleted(context, appWidgetIds)
                  val prefs = ShelfPreferences(context.applicationContext)
                  for (appWidgetId in appWidgetIds) {
                      cancelAllSlotPendingIntents(context.applicationContext, appWidgetId)
                      prefs.clearWidget(appWidgetId)
