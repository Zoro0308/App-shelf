                  instanceSpinner.onItemSelectedListener = null
                  instanceSpinner.adapter = adapter

                  val selectedIdx = activeWidgetIds.indexOf(selectedWidgetId).coerceAtLeast(0)
                  instanceSpinner.setSelection(selectedIdx, false)

                  instanceSpinner.onItemSelectedListener = object : AdapterView.OnItemSelectedListener {
                      override fun onItemSelected(
                          parent: AdapterView<*>?,
                          view: View?,
                          position: Int,
                          id: Long
                      ) {
                          if (position in activeWidgetIds.indices) {
                              val newId = activeWidgetIds[position]
                              if (newId != selectedWidgetId) {
                                  selectedWidgetId = newId
                                  refreshPreviewForSelectedWidget()
                              }
                          }
                      }

                      override fun onNothingSelected(parent: AdapterView<*>?) = Unit
                  }
              }

              private fun renderLiveShelfPreviewBackground(widthPx: Int, heightPx: Int) {
                  if (widthPx <= 0 || heightPx <= 0) return
                  val density = resources.displayMetrics.density
                  val bitmap: Bitmap = ShelfCanvasRenderer.renderShelves(widthPx, heightPx, density)
                  previewShelfBackground.setImageBitmap(bitmap)
              }

              private fun refreshPreviewForSelectedWidget() {
                  val widgetId = selectedWidgetId
                  if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return

                  if (previewStageContainer.width > 0 && previewStageContainer.height > 0) {
                      renderLiveShelfPreviewBackground(previewStageContainer.width, previewStageContainer.height)
                  } else {
                      previewStageContainer.post {
                          renderLiveShelfPreviewBackground(
                              previewStageContainer.width,
                              previewStageContainer.height
                          )
                      }
                  }

                  val assignments = shelfPreferences.getAllSlots(widgetId)
                  val pm = packageManager
                  val iconSizePx = (44f * resources.displayMetrics.density).toInt().coerceAtLeast(48)
                  var validAssignedCount = 0

                  for (slotIndex in 0 until ShelfPreferences.TOTAL_SLOTS) {
                      val iconView = slotIconViews[slotIndex] ?: continue
                      val labelView = slotLabelViews[slotIndex] ?: continue
                      val clearBtn = slotClearButtons[slotIndex] ?: continue
                      val cardView = slotCardContainers[slotIndex] ?: continue

                      val packageName = assignments[slotIndex]
                      if (!packageName.isNullOrEmpty()) {
                          val resolved = resolveAppPreview(pm, packageName, iconSizePx)
                          if (resolved != null) {
                              validAssignedCount++
                              iconView.setImageBitmap(resolved.second)
                              iconView.alpha = 1.0f
                              labelView.text = resolved.first
                              labelView.setTextColor(getColor(R.color.shelf_text_primary))
                              clearBtn.visibility = View.VISIBLE
                              cardView.isSelected = true
                          } else {
                              shelfPreferences.clearSlot(widgetId, slotIndex)
                              bindEmptyPreviewSlot(iconView, labelView, clearBtn, cardView)
                          }
                      } else {
                          bindEmptyPreviewSlot(iconView, labelView, clearBtn, cardView)
                      }
                  }

                  instanceStatusText.text = getString(
                      R.string.instance_status_summary_format,
                      widgetId,
                      validAssignedCount,
                      ShelfPreferences.TOTAL_SLOTS,
                      activeWidgetIds.size
                  )
              }

              private fun bindEmptyPreviewSlot(
                  iconView: ImageView,
                  labelView: TextView,
                  clearBtn: ImageButton,
                  cardView: View
              ) {
                  iconView.setImageResource(R.drawable.ic_slot_add)
                  iconView.alpha = 0.72f
                  labelView.text = getString(R.string.slot_empty_tap_to_add)
                  labelView.setTextColor(getColor(R.color.shelf_text_secondary))
                  clearBtn.visibility = View.GONE
                  cardView.isSelected = false
              }

              private fun resolveAppPreview(
                  pm: PackageManager,
                  packageName: String,
                  iconSizePx: Int
              ): Pair<String, Bitmap>? {
                  return try {
                      val launchIntent = pm.getLaunchIntentForPackage(packageName) ?: return null
                      val appInfo = pm.getApplicationInfo(packageName, 0)
                      val label = pm.getApplicationLabel(appInfo)?.toString()?.ifBlank { packageName }
                          ?: packageName
                      val iconDrawable = pm.getApplicationIcon(appInfo)
                      val bitmap = ShelfWidgetProvider.drawableToSizedBitmap(iconDrawable, iconSizePx)
                      if (launchIntent.component == null && launchIntent.`package` == null) {
                          launchIntent.setPackage(packageName)
                      }
                      Pair(label, bitmap)
                  } catch (_: Throwable) {
                      null
                  }
              }

              private fun clearSlotAssignment(slotIndex: Int) {
                  val widgetId = selectedWidgetId
                  if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return
                  shelfPreferences.clearSlot(widgetId, slotIndex)
                  refreshPreviewForSelectedWidget()
                  populateInstanceSpinner()
                  ShelfWidgetProvider.requestUpdateWidget(this, widgetId)
              }

              private fun confirmClearAllSlotsForSelectedWidget() {
                  val widgetId = selectedWidgetId
                  if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return

                  AlertDialog.Builder(this)
                      .setTitle(R.string.dialog_clear_all_title)
                      .setMessage(getString(R.string.dialog_clear_all_message, widgetId))
                      .setPositiveButton(R.string.action_clear_all) { _, _ ->
                          shelfPreferences.clearAllSlotsForWidget(widgetId)
                          refreshPreviewForSelectedWidget()
                          populateInstanceSpinner()
                          ShelfWidgetProvider.requestUpdateWidget(this, widgetId)
                          Toast.makeText(
                              this,
                              getString(R.string.toast_cleared_widget_slots, widgetId),
                              Toast.LENGTH_SHORT
                          ).show()
                      }
                      .setNegativeButton(android.R.string.cancel, null)
                      .show()
              }

              private fun applyAndRefreshSelectedWidget() {
                  val widgetId = selectedWidgetId
                  if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return

                  lifecycleScope.launch {
                      ShelfWidgetProvider.updateSingleWidgetNow(this@MainActivity, widgetId)

                      if (isConfigureFlow && widgetId == configuredWidgetId) {
                          val resultIntent = Intent().putExtra(
                              AppWidgetManager.EXTRA_APPWIDGET_ID,
                              configuredWidgetId
                          )
                          setResult(Activity.RESULT_OK, resultIntent)
                          Toast.makeText(
                              this@MainActivity,
                              getString(R.string.toast_widget_updated, widgetId),
                              Toast.LENGTH_SHORT
                          ).show()
                          finish()
                      } else {
                          Toast.makeText(
                              this@MainActivity,
                              getString(R.string.toast_widget_updated, widgetId),
                              Toast.LENGTH_SHORT
                          ).show()
                      }
                  }
              }

              private fun finishConfigurationWithEmptyOrCurrentState() {
                  if (configuredWidgetId != AppWidgetManager.INVALID_APPWIDGET_ID) {
                      shelfPreferences.ensureWidgetInitialized(configuredWidgetId)
                      lifecycleScope.launch {
                          ShelfWidgetProvider.updateSingleWidgetNow(this@MainActivity, configuredWidgetId)
                          val resultIntent = Intent().putExtra(
                              AppWidgetManager.EXTRA_APPWIDGET_ID,
                              configuredWidgetId
                          )
                          setResult(Activity.RESULT_OK, resultIntent)
                          finish()
                      }
                  } else {
                      finish()
                  }
              }

              private fun requestPinShelfWidget() {
                  if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O &&
                      appWidgetManager.isRequestPinAppWidgetSupported
                  ) {
                      val provider = ComponentName(this, ShelfWidgetProvider::class.java)
                      val pinned = appWidgetManager.requestPinAppWidget(provider, null, null)
                      if (!pinned) {
                          Toast.makeText(this, R.string.pin_widget_manual_hint, Toast.LENGTH_LONG).show()
                      }
                  } else {
                      Toast.makeText(this, R.string.pin_widget_manual_hint, Toast.LENGTH_LONG).show()
                  }
              }

              private fun preloadLaunchableAppsAsync() {
                  if (loadAppsJob?.isActive == true) return
                  loadAppsJob = lifecycleScope.launch {
                      cachedInstalledApps = queryLaunchableAppsOffMainThread(applicationContext)
                  }
              }

              private fun showAppPickerDialog(slotIndex: Int) {
                  val widgetId = selectedWidgetId
                  if (widgetId == AppWidgetManager.INVALID_APPWIDGET_ID) return

                  val dialogView = LayoutInflater.from(this)
                      .inflate(R.layout.dialog_app_picker, null, false)

                  val titleText = dialogView.findViewById<TextView>(R.id.picker_title_text)
                  val subtitleText = dialogView.findViewById<TextView>(R.id.picker_subtitle_text)
                  val searchInput = dialogView.findViewById<EditText>(R.id.edit_search_apps)
                  val btnClearSlotInPicker = dialogView.findViewById<Button>(R.id.btn_picker_clear_slot)
                  val progressBar = dialogView.findViewById<ProgressBar>(R.id.picker_progress_bar)
                  val emptySearchText = dialogView.findViewById<TextView>(R.id.picker_empty_text)
                  val recyclerView = dialogView.findViewById<RecyclerView>(R.id.recycler_app_picker)

                  val shelfNum = (slotIndex / ShelfPreferences.SLOTS_PER_SHELF) + 1
                  val posInShelf = (slotIndex % ShelfPreferences.SLOTS_PER_SHELF) + 1
                  titleText.text = getString(R.string.picker_dialog_title_format, shelfNum, posInShelf)

                  val currentPkg = shelfPreferences.getAppForSlot(widgetId, slotIndex)
                  subtitleText.text = if (!currentPkg.isNullOrEmpty()) {
                      getString(R.string.picker_dialog_subtitle_assigned, widgetId, currentPkg)
                  } else {
                      getString(R.string.picker_dialog_subtitle_empty, widgetId)
                  }

                  val dialog = AlertDialog.Builder(this)
                      .setView(dialogView)
                      .setNegativeButton(android.R.string.cancel, null)
                      .create()

                  btnClearSlotInPicker.visibility = if (currentPkg.isNullOrEmpty()) View.GONE else View.VISIBLE
                  btnClearSlotInPicker.setOnClickListener {
                      clearSlotAssignment(slotIndex)
                      dialog.dismiss()
                  }

                  val adapter = AppPickerAdapter { selectedApp ->
                      val launchable = packageManager.getLaunchIntentForPackage(selectedApp.packageName) != null
                      if (!launchable) {
                          Toast.makeText(this, R.string.error_app_no_longer_available, Toast.LENGTH_SHORT).show()
                          cachedInstalledApps = null
                          preloadLaunchableAppsAsync()
                          dialog.dismiss()
                          return@AppPickerAdapter
                      }

                      shelfPreferences.saveAppToSlot(widgetId, slotIndex, selectedApp.packageName)
                      refreshPreviewForSelectedWidget()
                      populateInstanceSpinner()
                      ShelfWidgetProvider.requestUpdateWidget(this, widgetId)
                      dialog.dismiss()
                  }

                  recyclerView.layoutManager = LinearLayoutManager(this)
                  recyclerView.adapter = adapter

                  searchInput.addTextChangedListener(object : TextWatcher {
                      override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
                      override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
                          val hasMatches = adapter.filter(s?.toString().orEmpty())
                          emptySearchText.visibility = if (hasMatches) View.GONE else View.VISIBLE
                      }
                      override fun afterTextChanged(s: Editable?) = Unit
                  })

                  dialog.show()

                  lifecycleScope.launch {
                      progressBar.visibility = View.VISIBLE
                      val apps = cachedInstalledApps ?: queryLaunchableAppsOffMainThread(applicationContext).also {
                          cachedInstalledApps = it
                      }
                      progressBar.visibility = View.GONE
                      val hasMatches = adapter.submitFullList(apps, searchInput.text?.toString().orEmpty())
                      emptySearchText.visibility = if (hasMatches) View.GONE else View.VISIBLE
                  }
              }

              private suspend fun queryLaunchableAppsOffMainThread(
                  context: Context
              ): List<LaunchableAppEntry> = withContext(Dispatchers.IO) {
                  val pm = context.packageManager
                  val mainIntent = Intent(Intent.ACTION_MAIN, null).apply {
                      addCategory(Intent.CATEGORY_LAUNCHER)
                  }

                  val resolveInfos = try {
                      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
                          pm.queryIntentActivities(mainIntent, PackageManager.ResolveInfoFlags.of(0L))
                      } else {
                          @Suppress("DEPRECATION")
                          pm.queryIntentActivities(mainIntent, 0)
                      }
                  } catch (_: Throwable) {
                      emptyList()
                  }

                  val uniqueByPackage = LinkedHashMap<String, LaunchableAppEntry>()
                  for (info in resolveInfos) {
                      val activityInfo = info.activityInfo ?: continue
                      val pkgName = activityInfo.packageName ?: continue
                      if (uniqueByPackage.containsKey(pkgName)) continue

                      val label = try {
                          info.loadLabel(pm)?.toString()?.trim()?.ifEmpty { pkgName } ?: pkgName
                      } catch (_: Throwable) {
                          pkgName
                      }

                      val icon: Drawable? = try {
                          info.loadIcon(pm)
                      } catch (_: Throwable) {
                          null
                      }

                      uniqueByPackage[pkgName] = LaunchableAppEntry(
                          label = label,
                          packageName = pkgName,
                          icon = icon
                      )
                  }

                  uniqueByPackage.values.sortedWith(
                      compareBy<LaunchableAppEntry> { it.label.lowercase(Locale.ROOT) }
                          .thenBy { it.packageName.lowercase(Locale.ROOT) }
                  )
              }

              data class LaunchableAppEntry(
                  val label: String,
                  val packageName: String,
                  val icon: Drawable?
              )

              private inner class AppPickerAdapter(
                  private val onAppSelected: (LaunchableAppEntry) -> Unit
              ) : RecyclerView.Adapter<AppPickerAdapter.AppViewHolder>() {

                  private var allApps: List<LaunchableAppEntry> = emptyList()
                  private var filteredApps: List<LaunchableAppEntry> = emptyList()

                  fun submitFullList(apps: List<LaunchableAppEntry>, currentQuery: String): Boolean {
                      allApps = apps
                      return filter(currentQuery)
                  }

                  fun filter(rawQuery: String): Boolean {
                      val q = rawQuery.trim().lowercase(Locale.ROOT)
                      filteredApps = if (q.isEmpty()) {
                          allApps
                      } else {
                          allApps.filter {
                              it.label.lowercase(Locale.ROOT).contains(q) ||
                                  it.packageName.lowercase(Locale.ROOT).contains(q)
                          }
                      }
                      notifyDataSetChanged()
                      return filteredApps.isNotEmpty()
                  }

                  override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): AppViewHolder {
                      val view = LayoutInflater.from(parent.context)
                          .inflate(R.layout.item_app_picker, parent, false)
                      return AppViewHolder(view)
                  }

                  override fun onBindViewHolder(holder: AppViewHolder, position: Int) {
                      holder.bind(filteredApps[position])
                  }

                  override fun getItemCount(): Int = filteredApps.size

                  inner class AppViewHolder(itemView: View) : RecyclerView.ViewHolder(itemView) {
                      private val iconView: ImageView = itemView.findViewById(R.id.item_app_icon)
                      private val nameView: TextView = itemView.findViewById(R.id.item_app_name)
                      private val packageView: TextView = itemView.findViewById(R.id.item_app_package)

                      fun bind(entry: LaunchableAppEntry) {
                          nameView.text = entry.label
                          packageView.text = entry.packageName
                          if (entry.icon != null) {
                              iconView.setImageDrawable(entry.icon)
                          } else {
                              iconView.setImageResource(R.drawable.ic_launcher_foreground)
                          }
                          itemView.setOnClickListener { onAppSelected(entry) }
                      }
                  }
              }

              companion object {
                  private const val STATE_SELECTED_WIDGET_ID = "state_selected_widget_id"
              }
          }
